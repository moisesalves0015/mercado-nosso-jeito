rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Default deny: all paths closed unless explicitly granted
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    // Profile photos:
    // - Public read for rendering avatars
    // - Owner write with validation (max 5MB, image content type)
    match /profile-photos/{uid}/{fileName} {
      allow read: if true;
      allow write: if isOwner(uid) 
                    && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow delete: if isOwner(uid) || isAdmin();
    }

    // Products images (uploaded via Admin CRM):
    // - Public read for catalogue
    // - Authenticated staff/admin write with image validation (max 10MB)
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated()
                    && request.resource.size < 10 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow delete: if isAuthenticated();
    }

    // Hero & Promotional Banners (uploaded via Admin Marketing CRM):
    match /banners/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated()
                    && request.resource.size < 30 * 1024 * 1024
                    && request.resource.contentType.matches('(image|video)/.*');
      allow delete: if isAuthenticated();
    }

    // Inbox ADM private attachments (max 15MB, authenticated staff/admin upload; access gated via RBAC & signed/callable URLs):
    match /admin-inbox/{messageId}/{attachmentId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated()
                    && request.resource.size < 15 * 1024 * 1024
                    && (
                      request.resource.contentType.matches('image/(jpeg|jpg|png|webp|gif)')
                      || request.resource.contentType == 'application/pdf'
                      || request.resource.contentType == 'text/csv'
                      || request.resource.contentType == 'application/csv'
                      || request.resource.contentType == 'text/plain'
                      || request.resource.contentType == 'application/msword'
                      || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
                      || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
                      || request.resource.contentType == 'application/vnd.ms-excel'
                    );
      allow delete: if false;
    }
  }
}
