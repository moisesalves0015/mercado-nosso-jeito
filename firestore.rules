rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ─── Default deny ────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }

    // ─── Helper functions ─────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }
    // NOTE: In production, prefer Custom Claims (request.auth.token.admin == true)
    // to avoid a read-per-request. Kept as-is to preserve existing architecture.
    function isAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ─── Products ─────────────────────────────────────────────────────────────
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();

      // Stock history written only by Admin SDK (Cloud Functions)
      match /stock_history/{historyId} {
        allow read: if isAdmin();
        allow write: if false; // Only Admin SDK
      }
    }

    // ─── Users ────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.role == 'client';
      allow update: if (
        isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'telefone', 'cpf', 'foto', 'unlockedBadges',
          'firstOrderPlaced', 'referralRewarded', 'updatedAt', 'lastLogin',
          'onboardingComplete'
        ])
      ) || isAdmin();
      allow delete: if isAdmin();

      // ── Addresses subcollection ───────────────────────────────────────────
      match /addresses/{addressId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // ── Clube VIP subcollection ───────────────────────────────────────────
      // Client can READ their own balance. All WRITES go through Cloud Functions
      // via Admin SDK (which bypasses these rules). This prevents:
      //   updateDoc(profileRef, { diamonds: 999999 })
      match /clube/{docId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if false; // Only Cloud Functions via Admin SDK
      }
    }

    // ─── Orders ───────────────────────────────────────────────────────────────
    match /orders/{orderId} {
      allow read: if (isAuthenticated() && resource.data.uid == request.auth.uid) || isAdmin();

      // Direct client creation is still allowed but validated.
      // TODO P1: restrict to Admin SDK only once createOrder Function is deployed.
      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasAll(['uid', 'status', 'items', 'total', 'createdAt']);

      // Only admins can update or delete orders
      allow update, delete: if isAdmin();
    }

    // ─── Inventory Logs ───────────────────────────────────────────────────────
    // Written exclusively by Cloud Functions / Admin SDK during order processing.
    // Clients must never write here directly.
    match /inventory_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Only Admin SDK
    }

    // ─── Configs / System ─────────────────────────────────────────────────────
    match /configs/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Settings / Shipping & App ───────────────────────────────────────────
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Campaign Configs ─────────────────────────────────────────────────────
    // Read by authenticated users (for display). Written only by admins.
    match /campaign_configs/{configId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ─── Diamond Transactions (Ledger) ────────────────────────────────────────
    // Immutable ledger. Clients can read their own history. Only Admin SDK writes.
    match /diamond_transactions/{transactionId} {
      allow read: if isAdmin()
        || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow write: if false; // Only Cloud Functions via Admin SDK
    }

    // ─── Reward Claims ────────────────────────────────────────────────────────
    // Clients can view their own reward status. Only Admin SDK writes/updates.
    match /reward_claims/{claimId} {
      allow read: if isAdmin()
        || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow write: if false; // Only Cloud Functions via Admin SDK
    }

    // ─── Gamification Events ──────────────────────────────────────────────────
    // Audit trail. Only admins read. Only Admin SDK writes.
    match /gamification_events/{eventId} {
      allow read: if isAdmin();
      allow write: if false; // Only Cloud Functions via Admin SDK
    }

  }
}
